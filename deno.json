{
  "name": "@mikeobank/pdec",
  "version": "0.1.0",
  "license": "MIT",
  "exports": "./mod.ts",
  "publish": {
    "exclude": ["AGENTS.md"]
  },
  "tasks": {
    "test": "deno test --allow-read --allow-write && rm -rf ./test_containers",
    "check": "deno check mod.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check"
  },
  "imports": {
    "@noble/ciphers": "npm:@noble/ciphers@^1.0",
    "@noble/hashes": "npm:@noble/hashes@^1.4",
    "@std/assert": "jsr:@std/assert@0.225.3"
  },
  "lint": {
    "rules": {
      "include": [
        "no-explicit-any",
        "no-unused-vars",
        "explicit-function-return-type",
        "explicit-module-boundary-types",
        "no-inferrable-types",
        "prefer-const"
      ]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 160,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": false,
    "trailingCommas": "never",
    "proseWrap": "preserve"
  }
}
