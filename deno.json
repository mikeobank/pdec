{
  "name": "@pdec/core",
  "version": "0.1.0",
  "exports": "./mod.ts",
  "tasks": {
    "test":      "deno test --allow-read --allow-write --allow-net tests/",
    "check":     "deno check mod.ts",
    "lint":      "deno lint src/ tests/",
    "fmt":       "deno fmt src/ tests/",
    "fmt:check": "deno fmt --check src/ tests/"
  },
  "imports": {
    "@noble/ciphers": "npm:@noble/ciphers@^1.0",
    "@noble/hashes":  "npm:@noble/hashes@^1.4",
    "@std/assert": "jsr:@std/assert@0.225.3"
  },
  "lint": {
    "rules": {
      "include": [
        "no-explicit-any",
        "no-unused-vars",
        "explicit-function-return-type",
        "explicit-module-boundary-types",
        "no-inferrable-types",
        "prefer-const"
      ]
    }
  },
  "fmt": {
    "useTabs":     false,
    "lineWidth":   100,
    "indentWidth": 2,
    "singleQuote": true,
    "semiColons": false,
    "proseWrap":   "preserve"
  }
}
