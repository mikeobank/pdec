IMPERATIVE SHELL — PDECContainer (src/core/container.ts)
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

PDECContainer is the only class in the library.
It owns one IRandomAccessHandle and one ContainerLayout.
It contains NO encryption, decryption, layout math, or header logic.
Every method body is a sequence of: read bytes → call functional core → write bytes.

  export interface PDECCreateOptions {
    path:       string;
    totalSize?: number;    // default 67108864
    maxSlots?:  number;    // default 8, max 32
    scheme?:    number;    // default 0x01
    overwrite?: boolean;   // default false
  }

  export interface WriteOptions {
    scheme?:       number;   // per-slot scheme override
    forceNewSlot?: boolean;  // allocate new slot even if passphrase has one
  }

  export interface SlotData {
    readonly data:      Uint8Array;
    readonly schemeId:  number;
    readonly writtenAt: Date;
    readonly slotIndex: number;
  }

  export class PDECContainer {

    /** Create a new container file. Fill entirely with randomBytes() before
     *  returning. Throw if file exists and overwrite is false. */
    static async create(options: PDECCreateOptions): Promise<PDECContainer>

    /** Open an existing container file. Does not validate any plaintext.
     *  Infers layout from file size using computeLayout defaults. */
    static async open(path: string): Promise<PDECContainer>

    /** Internal factory used by tests — accepts any IRandomAccessHandle.
     *  Not exported from mod.ts. */
    static _fromHandle(
      handle: IRandomAccessHandle,
      layout: ContainerLayout,
    ): PDECContainer

    /** Shuffle slot indices, scan all slots, apply jitter.
     *  Returns SlotData on success, undefined if no slot matched.
     *  Delegates entirely to shuffleIndices, scanSlots, jitter. */
    async read(passphrase: string): Promise<SlotData | undefined>

    /** Validate passphrase, find or allocate slot, encrypt, write, sync.
     *  Delegates to validatePassphrase, findFreeSlot, scanSlots,
     *  scheme.encrypt, buildHeader. */
    async write(
      passphrase: string,
      data:       Uint8Array,
      options?:   WriteOptions,
    ): Promise<void>

    /** Find slot, overwrite with randomBytes, sync.
     *  Returns false if passphrase had no slot, true if wiped.
     *  Delegates to scanSlots, randomBytes. */
    async wipe(passphrase: string): Promise<boolean>

    get layout(): ContainerLayout

    async close(): Promise<void>
  }

